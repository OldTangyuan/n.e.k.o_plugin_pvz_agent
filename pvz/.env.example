# ==========================================
# 猫娘玩 PVZ 的 AI 决策配置模板
# 复制为 .env 后填写，无需改动代码
# ==========================================

# ---------- AI 服务（远程 OpenAI 兼容接口）----------
VLM_BASE_URL=https://api.example.com/v1
VLM_MODEL=your-model-name
VLM_API_KEY=sk-xxxxxxxxxxxxxxxx

# ---------- 纯文本模式 AI 决策（mode="text" 时用，完全独立于上面的视觉模型）----------
# 可留空则自动回退用上面的 VLM_*（此时只设置 TEXT_VLM_MODEL 即可切换模型）。
# 建议用一个支持长思维链/思考模式的模型，text 模式默认开启 thinking。
TEXT_VLM_BASE_URL=
TEXT_VLM_MODEL=
TEXT_VLM_API_KEY=
